# Fastify
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blindfold?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=blindfold_session
COOKIE_SECURE=false

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080

# AI coach — your own OpenAI-compatible key (server-side only, never in the frontend)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=4000
# Score multiplier by hints used: 0,1,2,3,4+
HINT_PENALTIES=1,0.8,0.6,0.4,0.2
