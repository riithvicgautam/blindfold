# Fastify
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blindfold?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=blindfold_session
COOKIE_SECURE=false

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080
