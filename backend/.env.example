# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blindfold
# At least 32 random characters. Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string

# --- Optional ---
PORT=4000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:8080

# AI coach rephrasing: gemini | groq | none (hints still work with none)
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=4000
